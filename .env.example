# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Optional. Set to enable live email delivery from /api/contact.
RESEND_API_KEY=""

# CONTACT_TO_EMAIL: Recipient address for portfolio contact form submissions.
CONTACT_TO_EMAIL="kundan55xi@gmail.com"
